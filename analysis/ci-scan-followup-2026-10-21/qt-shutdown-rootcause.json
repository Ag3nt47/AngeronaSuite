  "inert_probe_source_utf8": "import sys\nimport atexit\nfrom PySide6.QtCore import QCoreApplication, QEvent\nfrom PySide6.QtWidgets import QApplication, QDialog, QWidget\nfrom angerona.gui.presentation_timer import PresentationTimer\nfrom shiboken6 import isValid\n\natexit.register(print, 'atexit-end', flush=True)\napp = QApplication([])\napp.setQuitOnLastWindowClosed(False)\ndialog = QDialog()\nowner = QWidget(dialog)\ntimer = PresentationTimer(owner)\ntimer.start(1000)\ndialog.show()\napp.processEvents()\nprint('before-delete', isValid(dialog), isValid(owner), isValid(timer), flush=True)\ndialog.deleteLater()\nQCoreApplication.sendPostedEvents(None, QEvent.DeferredDelete)\nprint('after-delete', isValid(dialog), isValid(owner), isValid(timer), flush=True)\napp.shutdown()\nprint('shutdown-complete', flush=True)\natexit.register(print, 'atexit-begin', flush=True)\nraise SystemExit(0)\n",
