{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angerona.local/schemas/capability-manifest-v1.schema.json",
  "title": "Angerona Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "api_version",
    "entrypoint",
    "sha256",
    "permissions",
    "events",
    "mitre",
    "privacy",
    "performance",
    "publisher",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "api_version": {
      "const": "1"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.py$",
      "maxLength": 260
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ai.infer",
          "credentials.read",
          "event.emit",
          "filesystem.read",
          "filesystem.write",
          "firewall.modify",
          "network.connect",
          "process.control",
          "process.inspect",
          "registry.read",
          "registry.write",
          "telemetry.read"
        ]
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "outputs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "mitre": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T\\d{4}(?:\\.\\d{3})?$"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classes", "egress", "retention"],
      "properties": {
        "data_classes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command_line",
              "credential_metadata",
              "file_content",
              "file_metadata",
              "identity",
              "memory",
              "network",
              "none",
              "process"
            ]
          }
        },
        "egress": {
          "enum": ["none", "local", "operator-approved"]
        },
        "retention": {
          "enum": ["memory", "flight-recorder", "custom"]
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_budget_pct", "memory_budget_mb", "poll_interval_s"],
      "properties": {
        "cpu_budget_pct": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "memory_budget_mb": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "poll_interval_s": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 86400
        }
      }
    },
    "publisher": {
      "type": "string",
      "maxLength": 128
    },
    "signature": {
      "type": "string",
      "maxLength": 512,
      "description": "Ed25519 signature over canonical JSON with this field removed; hex or base64."
    }
  }
}
